<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-packages" value="https://nuget.pkg.github.com/%PLATFORM_GITHUB_OWNER%/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping prevents Dependency Confusion and Namespace Squatting -->
  <packageSourceMapping>
    <packageSource key="github-packages">
      <package pattern="BuildingBlocks.*" />
      <package pattern="Platform.*" />
      <package pattern="OrderService.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="OpenTelemetry" />
      <package pattern="OpenTelemetry.*" />
      <package pattern="Npgsql" />
      <package pattern="Npgsql.*" />
      <package pattern="Dapper" />
      <package pattern="Dapper.*" />
      <package pattern="RabbitMQ.*" />
      <package pattern="Polly" />
      <package pattern="Polly.*" />
      <package pattern="Swashbuckle.*" />
      <package pattern="FluentAssertions" />
      <package pattern="FluentAssertions.*" />
      <package pattern="Testcontainers" />
      <package pattern="Testcontainers.*" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="coverlet.*" />
      <package pattern="CycloneDX.*" />
      <package pattern="DotNet.Testcontainers" />
      <package pattern="Docker.DotNet" />
      <package pattern="Docker.DotNet.*" />
      <package pattern="SharpZipLib" />
      <package pattern="Pipelines.Sockets.Unofficial" />
      <package pattern="BouncyCastle.Cryptography" />
      <package pattern="Microsoft.NET.Test.Sdk" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <github-packages>
      <add key="Username" value="%PLATFORM_NUGET_USER%" />
      <add key="ClearTextPassword" value="%PLATFORM_NUGET_TOKEN%" />
    </github-packages>
  </packageSourceCredentials>
</configuration>

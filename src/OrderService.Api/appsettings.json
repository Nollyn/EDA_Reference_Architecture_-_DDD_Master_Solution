{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=orders_db;Username=postgres;Password=postgres"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "MainExchange": "orders.topic",
    "RetryExchange": "orders.retry.direct",
    "DeadLetterExchange": "orders.dlx",
    "OrderCreatedQueue": "orders.v1.order-created",
    "InventoryEventsQueue": "orders.v1.inventory-events",
    "RetryQueue": "orders.v1.retry",
    "DeadLetterQueue": "orders.v1.dlq",
    "RetryTtlMilliseconds": 5000,
    "MaxDeliveryAttempts": 3
  },
  "ExternalServices": {
    "FraudCheckUrl": ""
  },
  "OpenTelemetry": {
    "ServiceName": "OrderService.Api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "PlatformSecurity": {
    "EnableDevMode": true,
    "Authority": "https://login.microsoftonline.com/common/v2.0",
    "Audience": "api://orderservice",
    "RequireHttpsMetadata": false
  }
}
